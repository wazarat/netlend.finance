{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-testnet",
      "runtimeExecutable": "env",
      "runtimeArgs": ["NEXT_PUBLIC_CHAIN=46630", "pnpm", "--filter", "@netlend/web", "dev"],
      "port": 3000
    },
    {
