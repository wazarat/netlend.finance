# Which address book the app reads: 46630 (Robinhood Chain testnet) or local (Anvil, scripts/rehearse-anvil.sh)
NEXT_PUBLIC_CHAIN=46630
# Browser RPC (wallet reads and writes). Defaults to the public testnet RPC, or 127.0.0.1:8545 for local.
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# Server-side RPC override for the /api route handlers (optional, falls back to NEXT_PUBLIC_RPC_URL)
RPC_URL=
